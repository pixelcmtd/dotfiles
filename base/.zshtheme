#!/bin/zsh
# vim:ft=zsh ts=2 sw=2 sts=2
# pixel's Theme - based on https://gist.github.com/3712874

CURRENT_BG=
CURRENT_FG=black
SEGMENT_SEPARATOR=$'\ue0b0'
PROMPT_GIT_STATUS_FILE="$(mktemp)"

# Begin a segment
# args: [background] [foreground] [message]
# If background or foreground is "", the default is used.
prompt_segment() {
  local bg fg
  [ -n $1 ] && bg="%K{$1}" || bg="%k"
  [ -n $2 ] && fg="%F{$2}" || fg="%f"
  if [[ -n $CURRENT_BG && $1 != $CURRENT_BG ]]; then
    echo -n " %{$bg%F{$CURRENT_BG}%}$SEGMENT_SEPARATOR%{$fg%} "
  else
    echo -n "%{$bg%}%{$fg%} "
  fi
  CURRENT_BG=$1
  echo -n "$3"
}

# End the prompt, closing any open segments
prompt_end() {
  if [ -n $CURRENT_BG ]; then
    echo -n " %{%k%F{$CURRENT_BG}%}$SEGMENT_SEPARATOR"
  else
    echo -n "%{%k%}"
  fi
  echo -n "%{%f%}"
  CURRENT_BG=
  CURRENT_FG=black
}

setopt promptsubst
autoload -Uz vcs_info

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' get-revision true
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' stagedstr "✚"
zstyle ':vcs_info:*' unstagedstr "●"
zstyle ':vcs_info:*' formats " %u%c"
zstyle ':vcs_info:*' actionformats " %u%c"

prompt_git() {
  local ref mode repo_path status_pid

  if $(git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
    git status --porcelain "--ignore-submodules=${GIT_STATUS_IGNORE_SUBMODULES:-dirty}" 2>/dev/null | tail -n1 >"$PROMPT_GIT_STATUS_FILE" &
    status_pid=$!
    repo_path=$(git rev-parse --git-dir 2>/dev/null)
    ref=$(git symbolic-ref HEAD 2>/dev/null) || ref="➦ $(git rev-parse --short HEAD 2> /dev/null)"

    if [ -e "${repo_path}/BISECT_LOG" ]; then
      mode=" <B>"
    elif [ -e "${repo_path}/MERGE_HEAD" ]; then
      mode=" >M<"
    elif [[ -e "${repo_path}/rebase" || -e "${repo_path}/rebase-apply" || -e "${repo_path}/rebase-merge" || -e "${repo_path}/../.dotest" ]]; then
      mode=" >R>"
    fi

    vcs_info
    msg="${ref/refs\/heads\//}${vcs_info_msg_0_%% }${mode}"

    wait $status_pid
    if [[ -n "$(cat "$PROMPT_GIT_STATUS_FILE")" ]]; then
      prompt_segment yellow black "$msg"
    else
      prompt_segment green $CURRENT_FG "$msg"
    fi
  fi
}

# - return value (if non-zero)
# - background job indicator (gear)
# - datetime
prompt_status() {
  local -a symbols
  [[ $RETVAL -ne 0 ]] && symbols+="%{%F{#C02020}%}$RETVAL"
  # partially broken, probably because of subshells
  [ $(jobs -l | wc -l) -gt 0 ] && symbols+="%{%F{cyan}%}⚙"
  symbols+="%f%D{%a %d. %b %H:%M}"
  prompt_segment "#202020" default "$symbols"
}

build_prompt() {
  RETVAL=$?
  prompt_status
  [ $UID -eq 0 ] && prompt_segment "#ff0000" black "😈" || prompt_segment "#C02020" black "%n"
  prompt_segment "#8020F0" black "%1~"
  prompt_git
  prompt_end
}

# TODO: more performance optimizations (partial prompt caching?)
# zmodload zsh/datetime && start=$EPOCHREALTIME && build_prompt >/dev/null && end=$EPOCHREALTIME && echo "$end - $start" | bc
PROMPT='%{%f%b%k%}$(build_prompt) '

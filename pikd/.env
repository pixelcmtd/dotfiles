# this is a zsh-specific hack
setopt NULL_GLOB
export PATH="$HOME/.local/bin:$HOME/.bin:$HOME/.rvm/bin:$HOME/.cargo/bin:$HOME/.mint/bin:$HOME/.jsvu:/home/linuxbrew/.linuxbrew/opt/rustup/bin:/home/linuxbrew/.linuxbrew/opt/llvm/bin:/home/linuxbrew/.linuxbrew/opt/bison/bin:/home/linuxbrew/.linuxbrew/opt/coreutils/libexec/gnubin:/home/linuxbrew/.linuxbrew/opt/ruby/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:$HOME/vcpkg:$HOME/flutter/bin:$HOME/.wasmer/bin:$HOME/.wasmer/globals/wapm_packages/.bin:$HOME/.emacs.d/bin:$HOME/.pub-cache/bin:$HOME/fvm/versions/stable/bin:$HOME/src/pixelcmtd/tldrgal:$HOME/go/bin:$HOME/perl5/bin:$HOME/.cabal/bin:$PATH$(
for d in \
        $HOME/.gem/ruby/*/bin \
        /home/linuxbrew/.linuxbrew/lib/ruby/gems/*/bin \
        /opt/*/bin
do
        echo -n ":$d"
done
)"
unsetopt NULL_GLOB

export FPATH="$FPATH:/home/linuxbrew/.linuxbrew/share/zsh/site-functions:/home/linuxbrew/.linuxbrew/share/zsh/functions:/usr/local/share/zsh/site-functions:/usr/local/share/zsh/functions"

export CC=clang
export CFLAGS="-O3 -mcpu=native -mtune=native -I/home/linuxbrew/.linuxbrew/include -L/home/linuxbrew/.linuxbrew/lib -Wno-unused-command-line-argument -Wall -Wextra"
export CXX=clang++
export CXXFLAGS="$CFLAGS"
export LD=$CC
export LDFLAGS="$CFLAGS -L/home/linuxbrew/.linuxbrew/lib -flto"

export GPG_TTY=$(tty)
export CARP_DIR=$HOME/src/Carp/
export CHROME_EXECUTABLE="/usr/bin/helium"

#!/bin/zsh
export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export LC_MESSAGES=C
export LC_MONETARY=C
export LC_NUMERIC=C
export LC_TIME=C
export LC_ALL=
export EDITOR=nvim
export VISUAL=$EDITOR
export PAGER=less
export TERM=xterm-256color
export LS_COLORS=

# this is a zsh-specific hack
setopt NULL_GLOB
export PATH="$HOME/.local/bin:$HOME/.bin:$HOME/.rvm/bin:$HOME/.cargo/bin:$HOME/.mint/bin:/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin:$HOME/.jsvu:/opt/homebrew/opt/rustup/bin:/opt/homebrew/opt/llvm/bin:/opt/homebrew/opt/bison/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/opt/ruby/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/vcpkg:$HOME/flutter/bin:$HOME/.wasmer/bin:$HOME/.wasmer/globals/wapm_packages/.bin:$HOME/.emacs.d/bin:$HOME/.pub-cache/bin:$HOME/fvm/versions/stable/bin:$HOME/src/pixelcmtd/tldrgal:$HOME/go/bin:$HOME/perl5/bin:$HOME/.cabal/bin:/Applications/Xcode.app/Contents/Developer/usr/bin:$PATH$(
for d in \
        $HOME/Library/Python/*/bin \
        /Applications/*.app/Contents/MacOS \
        $HOME/JUCE/*.app/Contents/MacOS \
        $HOME/.gem/ruby/*/bin \
        /opt/homebrew/lib/ruby/gems/*/bin \
        /opt/*/bin
do
        echo -n ":$d"
done
)"
unsetopt NULL_GLOB

export FPATH="$FPATH:/opt/homebrew/share/zsh/site-functions:/opt/homebrew/share/zsh/functions:/usr/local/share/zsh/site-functions:/usr/local/share/zsh/functions"

export MACOSX_DEPLOYMENT_TARGET=15.0
export CC=clang
export CFLAGS="-O3 -mcpu=native -mtune=native -I/opt/homebrew/include -L/opt/homebrew/lib -Wno-unused-command-line-argument -Wall -Wextra"
export CXX=clang++
export CXXFLAGS="$CFLAGS"
export LD=$CC
export LDFLAGS="$CFLAGS -L/opt/homebrew/lib -flto"
export PREFIX="$HOME/.local"

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_DOWNLOAD_CONCURRENCY=auto
export GPG_TTY=$(tty)
export CARP_DIR=$HOME/src/Carp/
export CHROME_EXECUTABLE="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"

alias x86brew="arch -x86_64 /usr/local/bin/brew"

